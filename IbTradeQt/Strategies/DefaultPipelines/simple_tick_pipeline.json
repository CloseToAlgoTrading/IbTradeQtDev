{
    "name": "Tick Alpha (Mean Reversion)",
    "description": "Mean reversion alpha driven by quote ticks; used for integration tests that feed ticks without historical data",
    "alphas": [
        {
            "blockId": "mean-reversion-alpha",
            "config": {
                "period": 5,
                "stdDevThreshold": 0.5
            }
        }
    ],
    "rebalance": {
        "blockId": "simple-rebalance",
        "config": {
            "defaultQuantity": 100.0
        }
    },
    "risks": [
        {
            "blockId": "max-position-risk",
            "config": {
                "maxPositionSize": 1000.0,
                "maxTotalExposure": 5000.0
            }
        }
    ],
    "execution": {
        "blockId": "market-order-execution",
        "config": {
            "minQuantity": 1.0
        }
    }
}
