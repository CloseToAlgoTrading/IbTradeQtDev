{
    "name": "Simple Momentum Strategy",
    "description": "Single alpha momentum strategy with risk management",
    "alphas": [
        {
            "blockId": "momentum-alpha",
            "config": {
                "period": 20,
                "threshold": 0.02
            }
        }
    ],
    "rebalance": {
        "blockId": "simple-rebalance",
        "config": {
            "defaultQuantity": 100.0
        }
    },
    "risks": [
        {
            "blockId": "max-position-risk",
            "config": {
                "maxPositionSize": 1000.0,
                "maxTotalExposure": 5000.0
            }
        }
    ],
    "execution": {
        "blockId": "market-order-execution",
        "config": {
            "minQuantity": 1.0
        }
    }
}
