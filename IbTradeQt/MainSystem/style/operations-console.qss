/* Operations Console — Professional Finance Terminal Theme
 *  Centralized QSS for the Qt GUI. Edit palette below to retheme the app.
 *
 *  C++ cannot read this file. Shared hex tokens for runtime stylesheets live in
 *  MainSystem/ThemePalette.h (namespace UiTheme) — keep those literals in sync
 *  with the palette and rules below.
 *
 *  ── THEME PALETTE (reference for designers & developers) ─────────────────
 *  bgWindow      #1b1b1b   Main windows / panels
 *  bgElevated    #212121   Inputs, cards, popups
 *  bgChrome      #161616   Toolbars, headers, dock title
 *  borderSubtle  #2a2a2a   Dividers, group frames
 *  borderField   #333333   Input borders
 *  borderFocus   #507dbc   Focus ring (accent blue)
 *  textPrimary   #e8e8e8   Body labels, readable text
 *  textSecondary #b8b8b8   Combo/spin text, less emphasis
 *  textMuted     #888888   Group titles, hints
 *  textDisabled  #666666
 *  selectionBg   #2a3a50   Selection highlight
 *  accent        #507dbc   Buttons, tabs, focus
 *  ────────────────────────────────────────────────────────────────────────── */

* {
    font-family: "Roboto Condensed", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

/* ── Base widget defaults (inherits to most children) ── */
QWidget {
    background-color: transparent;
    color: #d0d0d0;
    font-size: 12px;
}

QMainWindow,
QDialog,
QWizard {
    background-color: #1b1b1b;
    color: #d0d0d0;
}

/* ── Labels ── */
QLabel {
    color: #e8e8e8;
    font-size: 12px;
    background-color: transparent;
}

/* Row labels in form layouts (Mode:, Interval N:, etc.) */
QFormLayout QLabel {
    color: #f0f0f0;
    font-size: 12px;
    font-weight: 400;
    min-height: 20px;
}

/* Optional: set QLabel objectName="labelMuted" or dynamic property for hints */
QLabel#labelMuted,
QLabel[mute="true"] {
    color: #888888;
    font-size: 11px;
}

/* ── Global Status Bar ── */
#GlobalStatusBar {
    background-color: #141414;
    border-bottom: 1px solid #2a2a2a;
}

#GlobalStatusBar QLabel#statusIndicator {
    color: #999;
    font-size: 11px;
    font-weight: 500;
    padding: 0 6px;
}

#GlobalStatusBar QLabel#statusIndicator[statusState="ok"] {
    color: #4caf50;
}
#GlobalStatusBar QLabel#statusIndicator[statusState="warning"] {
    color: #ff9800;
}
#GlobalStatusBar QLabel#statusIndicator[statusState="error"] {
    color: #e53935;
}
#GlobalStatusBar QLabel#statusIndicator[statusState="neutral"] {
    color: #666;
}

#GlobalStatusBar QPushButton#globalActionBtn {
    background-color: #252525;
    color: #ccc;
    border: 1px solid #383838;
    border-radius: 2px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 500;
}
#GlobalStatusBar QPushButton#globalActionBtn:hover {
    background-color: #333;
    border-color: #507dbc;
    color: #e0e0e0;
}
#GlobalStatusBar QPushButton#globalActionBtn:pressed {
    background-color: #507dbc;
    color: #fff;
}

/* ── Push buttons (application-wide) ── */
QPushButton {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 3px;
    padding: 5px 14px;
    font-size: 12px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #333333;
    border-color: #507dbc;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #3d5a80;
    border-color: #507dbc;
}
QPushButton:disabled {
    background-color: #252525;
    color: #666666;
    border-color: #333333;
}
QPushButton:focus {
    border-color: #507dbc;
}

/* ── Main tab widget (Live, Backtest, Strategy Management) ── */
QTabWidget#MainTabWidget::pane {
    border: none;
}
QTabWidget#MainTabWidget QTabBar::tab {
    padding: 6px 18px;
    font-size: 12px;
    color: #b0b0b0;
}
QTabWidget#MainTabWidget QTabBar::tab:selected {
    font-weight: bold;
    color: #e8e8e8;
}
QTabWidget#MainTabWidget QTabBar::tab:hover:!selected {
    color: #cccccc;
}
QTabWidget#MainTabWidget QTreeView,
QTabWidget#MainTabWidget QTreeWidget {
    font-family: "Consolas", "SF Mono", "Roboto Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    qproperty-indentation: 10;
}

/* ── Tree View (shared across Live, Backtest, Catalog panels) ── */
/*
 * Horizontal “left spacing” knobs:
 *   • Per depth level (child indent): qproperty-indentation: <px>;  (QTreeView Q_PROPERTY)
 *   • Per row (cell padding):       QTreeView::item { padding-left: ...; }
 * Strategy tree icon/text gaps in column 0 are painted in StrategyTreeDelegate (IconLeftPad,
 * TextLeftPad) — change those in C++ if that spacing is wrong, not here.
 */
QTreeView, QTreeWidget {
    /* Example: tighter nesting per level — uncomment:
    qproperty-indentation: 14;
    */
    background-color: #1b1b1b;
    alternate-background-color: #1f1f1f;
    color: #d0d0d0;
    border: none;
    selection-background-color: #2a3a50;
    selection-color: #e8e8e8;
    font-family: "Consolas", "SF Mono", "Roboto Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    outline: 0;
}

QTreeView::item, QTreeWidget::item {
    height: 20px;
    padding: 1px 3px;
    border: none;
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #2a3a50;
}

QTreeView::item:hover:!selected, QTreeWidget::item:hover:!selected {
    background-color: #232323;
}

QTreeView::branch, QTreeWidget::branch {
    background: transparent;
}

QTreeView::branch:has-children:closed,
QTreeWidget::branch:has-children:closed {
    border-image: none;
    image: none;
}

QTreeView::branch:has-children:open,
QTreeWidget::branch:has-children:open {
    border-image: none;
    image: none;
}

QHeaderView::section {
    background-color: #161616;
    color: #888;
    border: none;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    padding: 3px 6px;
    font-family: "Consolas", "SF Mono", "Roboto Mono", "DejaVu Sans Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ── Settings slide panel ──────────────────────────────────────────────────
 * Sheet width, tree min-height, header column sizing (qproperty-*) live here; not in C++.
 * Widen/narrow the sheet: edit min-width and max-width on #SettingsSlidePanel (e.g. 480px).
 */
QWidget#SettingsOverlay {
    background: transparent;
}
QFrame#SettingsOverlayBackdrop {
    background-color: rgba(0, 0, 0, 0.5);
    border: none;
}
QFrame#SettingsSlidePanel {
    /* Panel width (was kPanelWidth in code) */
    min-width: 480px;
    max-width: 480px;
    background-color: #1a1a1a;
    border-left: 1px solid #333333;
    /* Inset for main column (replaces QVBoxLayout setContentsMargins L,T,R,B = 10,8,10,10) */
    padding: 8px 10px 10px 10px;
}

/* Settings tree: min height + header so "Parameter" column is wider; Value column stretches */
QFrame#SettingsSlidePanel QTreeView#settingsTreeView {
    min-height: 200px;
    /* Gap below title row (replaces QVBoxLayout setSpacing(8)) */
    margin-top: 8px;
}
QFrame#SettingsSlidePanel QTreeView#settingsTreeView QHeaderView {
    qproperty-defaultSectionSize: 268;
    qproperty-minimumSectionSize: 96;
    qproperty-stretchLastSection: true;
}
QLabel#SettingsSlideTitle {
    color: #e8e8e8;
    font-size: 14px;
    font-weight: 600;
    margin: 0px;
}
QToolButton#SettingsSlideCloseButton {
    color: #cccccc;
    font-size: 20px;
    font-weight: 400;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    margin: 0px;
    border: none;
    border-radius: 4px;
}
QToolButton#SettingsSlideCloseButton:hover {
    background-color: #3a3a3a;
    color: #ffffff;
}

/* ── Context Workspace ── */
#ContextWorkspace {
    background-color: #1b1b1b;
}

#WorkspaceHeader {
    background-color: #1b1b1b;
    border-bottom: 1px solid #2a2a2a;
}

#WorkspaceHeader QLabel#wsTitle {
    color: #e0e0e0;
    font-size: 14px;
    font-weight: 600;
}

#WorkspaceHeader QLabel#wsBreadcrumb {
    color: #8888a0;
    font-size: 11px;
}

/* Workspace header state badge: base chrome only; background stays data-driven in C++ */
#WorkspaceHeader QLabel#wsStateBadge {
    color: #ffffff;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    min-height: 22px;
}

/* ── Metrics Strip ── */
#MetricsStrip {
    background-color: #1b1b1b;
    border-bottom: 1px solid #2a2a2a;
}

QFrame#metricCard {
    background-color: #252538;
    border: 1px solid #2a2a3a;
    border-radius: 4px;
    padding: 4px 8px;
}

QFrame#metricCard QLabel#metricCardLabel {
    color: #8888a0;
    font-size: 10px;
}

QFrame#metricCard QLabel#metricCardValue {
    color: #e0e0e0;
    font-size: 13px;
    font-weight: bold;
}

/* ── Context / placeholders / hints (was inline setStyleSheet) ── */
QLabel#ContextWorkspaceEmptyHint {
    color: #8888a0;
    font-size: 14px;
}

QLabel#BacktestPlaceholderLabel {
    color: #707070;
    font-size: 13px;
}

/* Strategy workspace overview */
QLabel#strategyOverviewState {
    font-size: 14px;
    color: #d0d0d0;
}

QLabel#strategyOverviewWarning {
    color: #eab308;
    font-size: 12px;
}

QLabel#strategyOverviewMuted {
    color: #888888;
    font-size: 12px;
}

QLabel#workspaceFormHint {
    color: #888888;
    font-size: 11px;
    font-style: italic;
}

/* Backtest selector panel */
QLabel#panelHeader {
    padding: 6px 6px 2px 6px;
}

QLabel#countLabel {
    padding: 2px 6px;
    color: #a0a0a0;
    font-size: 11px;
}

QLabel#BacktestStatusLabel {
    color: #909090;
    font-style: italic;
    font-size: 12px;
}

QLabel#BacktestUniverseHint {
    color: #888888;
    font-size: 11px;
    font-style: italic;
}

/* Block inspector (backtest “Block Details”) */
QLabel#InspectorEmptyHint,
QLabel#InspectorEmptyParams {
    color: #888888;
    font-style: italic;
}

QLabel#InspectorBlockDescription {
    color: #777777;
    font-size: 11px;
    margin-bottom: 8px;
}

QLabel#InspectorSectionSpacer {
    margin-top: 12px;
}

QLabel#InspectorInfoValue {
    color: #aaaaaa;
}

/* ── Tab Widget ── */
QTabWidget::pane {
    background-color: #1b1b1b;
    border: none;
    border-top: 1px solid #2a2a2a;
}

QTabBar::tab {
    background-color: transparent;
    color: #777777;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #e0e0e0;
    border-bottom: 2px solid #507dbc;
}

QTabBar::tab:hover:!selected {
    color: #aaaaaa;
}

/* Backtest workspace (Run Configuration / Block Details + Run History / …):
 * Blue line under the selected tab = border-bottom on QTabBar::tab:selected (accent #507dbc). */
QTabWidget#BacktestWorkspaceConfigTabs::pane,
QTabWidget#BacktestWorkspaceResultTabs::pane {
    background-color: #1b1b1b;
    border: none;
    border-top: 1px solid #2a2a2a;
}

QTabWidget#BacktestWorkspaceConfigTabs QTabBar::tab,
QTabWidget#BacktestWorkspaceResultTabs QTabBar::tab {
    background-color: transparent;
    color: #777777;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 500;
}

QTabWidget#BacktestWorkspaceConfigTabs QTabBar::tab:selected,
QTabWidget#BacktestWorkspaceResultTabs QTabBar::tab:selected {
    color: #e0e0e0;
    border-bottom: 2px solid #507dbc; /* THEME: accent / borderFocus */
}

QTabWidget#BacktestWorkspaceConfigTabs QTabBar::tab:hover:!selected,
QTabWidget#BacktestWorkspaceResultTabs QTabBar::tab:hover:!selected {
    color: #aaaaaa;
}

/* Backtest / Strategy Management context strip: “No strategy selected” / strategy title */
QLabel#BacktestWorkspaceContextHeader {
    background-color: #212121;
    color: #d0d0d0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 8px 10px;
    font-size: 13px;
    font-weight: 600;
}

/* ── Event Log Panel / Dock Widgets ── */
#EventLogPanel {
    background-color: #1b1b1b;
}

QDockWidget {
    color: #cccccc;
    font-size: 11px;
}

QDockWidget::title {
    background-color: #161616;
    color: #999999;
    padding: 4px 8px;
    border-bottom: 1px solid #2a2a2a;
    font-weight: 600;
}

/* ── Frames ── */
QFrame {
    color: #d0d0d0;
    border: none;
}

/* ── Table Views ── */
QTableView {
    background-color: #1b1b1b;
    alternate-background-color: #1f1f1f;
    color: #d0d0d0;
    gridline-color: #252525;
    border: none;
    selection-background-color: #2a3a50;
    selection-color: #e8e8e8;
    font-size: 11px;
}

QTableView QHeaderView::section {
    background-color: #161616;
    color: #888888;
    border: none;
    border-right: 1px solid #252525;
    border-bottom: 1px solid #2a2a2a;
    padding: 3px 6px;
    font-size: 10px;
    font-weight: 600;
}

/*
 * Backtest dock: Run History & Trade Log use objectName BacktestRunHistoryTable /
 * BacktestTradeLogTable. They inherit all QTableView rules above.
 * Do not set ForegroundRole/BackgroundRole in the model for “theme” colours —
 * Qt stylesheets cannot style cells from model data (no per-row QSS selectors).
 * For data-driven colours (e.g. status), use a QStyledItemDelegate instead.
 */

/* ── List widgets ── */
QListWidget, QListView {
    background-color: #1b1b1b;
    color: #d0d0d0;
    border: 1px solid #2a2a2a;
    border-radius: 2px;
    font-size: 12px;
    selection-background-color: #2a3a50;
    selection-color: #ffffff;
    outline: 0;
}
QListWidget::item:hover:!selected {
    background-color: #252525;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #383838;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background-color: #505050;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #383838;
    border-radius: 3px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #505050;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── Text inputs (single & multi line) ── */
QLineEdit {
    background-color: #212121;
    color: #e8e8e8;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
    selection-background-color: #2a3a50;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #507dbc;
}
QLineEdit:hover:!focus {
    border-color: #444444;
}
QLineEdit:disabled {
    background-color: #1a1a1a;
    color: #666666;
    border-color: #333333;
}

QTextEdit,
QPlainTextEdit {
    background-color: #212121;
    color: #e8e8e8;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
    selection-background-color: #2a3a50;
    selection-color: #ffffff;
}
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #507dbc;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #2a2a2a;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ── Menu Bar ── */
QMenuBar {
    background-color: #141414;
    color: #bbbbbb;
    border-bottom: 1px solid #2a2a2a;
    font-size: 12px;
}
QMenuBar::item {
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background-color: #2a2a2a;
    color: #e0e0e0;
}

QMenu {
    background-color: #212121;
    color: #d0d0d0;
    border: 1px solid #333333;
    padding: 4px 0;
    font-size: 12px;
}
QMenu::item {
    padding: 5px 24px 5px 12px;
}
QMenu::item:selected {
    background-color: #2a3a50;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 8px;
}

/* ── Tool Bar ── */
QToolBar {
    background-color: #161616;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    spacing: 2px;
    padding: 2px;
}
QToolButton {
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: 2px;
    color: #bbbbbb;
    font-size: 11px;
}
QToolButton:hover {
    background-color: #2a2a2a;
    color: #e0e0e0;
}
QToolButton:pressed {
    background-color: #333333;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #141414;
    color: #888888;
    border-top: 1px solid #2a2a2a;
    font-size: 11px;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #888888;
    font-size: 11px;
}

/* ── Combo Box ── */
QComboBox {
    background-color: #212121;
    color: #e8e8e8;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
    min-height: 20px;
    selection-background-color: #2a3a50;
}
QComboBox:hover {
    border-color: #507dbc;
}
QComboBox:focus {
    border-color: #507dbc;
}
QComboBox:disabled {
    background-color: #1a1a1a;
    color: #666666;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #212121;
    color: #e8e8e8;
    border: 1px solid #333333;
    selection-background-color: #2a3a50;
    selection-color: #ffffff;
    font-size: 12px;
    outline: 0;
}

/* ── Spin Box ── */
QSpinBox, QDoubleSpinBox {
    background-color: #212121;
    color: #e8e8e8;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 12px;
    min-height: 20px;
    selection-background-color: #2a3a50;
    selection-color: #ffffff;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #507dbc;
}
QSpinBox:hover:!focus, QDoubleSpinBox:hover:!focus {
    border-color: #444444;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #1a1a1a;
    color: #666666;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2a2a2a;
    border: 1px solid #333333;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #333333;
}

/* ── Radio button ── */
QRadioButton {
    color: #e0e0e0;
    font-size: 12px;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #5a5a5a;
    background-color: #1e1e1e;
}
QRadioButton::indicator:hover {
    border-color: #6a8fc4;
}
QRadioButton::indicator:checked {
    border: 2px solid #507dbc;
    background-color: #507dbc;
}
QRadioButton:disabled {
    color: #666666;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #507dbc;
    border: 1px solid #6a9fe6;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #3d5a80;
    border-radius: 2px;
}

/* ── Check Box (indicator + checkmark image) ── */
QCheckBox {
    color: #d0d0d0;
    spacing: 8px;
    font-size: 12px;
    font-weight: 400;
}
QGroupBox QCheckBox {
    color: #c8c8c8;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #5a5a5a;
    border-radius: 3px;
    background-color: #1e1e1e;
}
QCheckBox::indicator:hover:!checked {
    border-color: #6a8fc4;
    background-color: #252525;
}
QCheckBox::indicator:checked {
    border: 1px solid #507dbc;
    background-color: #2a3f5c;
    image: url(:/style/icons/checkbox-check.svg);
}
QCheckBox::indicator:checked:hover {
    border-color: #6a9fe6;
    background-color: #324a68;
    image: url(:/style/icons/checkbox-check.svg);
}
QCheckBox::indicator:disabled {
    border-color: #404040;
    background-color: #1a1a1a;
}
QCheckBox::indicator:checked:disabled {
    border-color: #454545;
    background-color: #2a2a2a;
    image: url(:/style/icons/checkbox-check.svg);
}
QCheckBox:disabled {
    color: #707070;
}

/* ── Group Box (section titles = muted) ── */
QGroupBox {
    color: #999999;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 10px;
    padding-bottom: 6px;
    font-weight: 600;
    font-size: 11px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #888888;
    background-color: #1b1b1b;
}

/* ── Tooltip ── */
QToolTip {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #444444;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── Progress Bar ── */
QProgressBar {
    background-color: #212121;
    border: 1px solid #333333;
    border-radius: 2px;
    text-align: center;
    color: #cccccc;
    font-size: 10px;
    height: 14px;
}
QProgressBar::chunk {
    background-color: #507dbc;
    border-radius: 1px;
}
